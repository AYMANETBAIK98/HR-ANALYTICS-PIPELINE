{
  "name": "HR Corporate",
  "dataColors": ["#1F4E79", "#2E86AB", "#F18F01", "#C73E1D", "#3B8B5A", "#8E8E93", "#9BC1BC", "#5D2E8C"],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1F4E79",
  "good": "#3B8B5A",
  "neutral": "#F18F01",
  "bad": "#C73E1D",
  "maximum": "#C73E1D",
  "center": "#FCE8D5",
  "minimum": "#FFFFFF",
  "textClasses": {
    "callout": { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#1F4E79" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#605E5C" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E4E8" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#252423" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }]
      }
    }
  }
}
